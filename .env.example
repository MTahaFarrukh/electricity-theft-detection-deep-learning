# Copy this file to `.env` and adjust values. Never commit `.env`.

# --- General ---
APP_ENV=development            # development | production (production hides internal error details)
RANDOM_SEED=42
LOG_LEVEL=INFO

# --- Data / model paths (relative to project root) ---
RAW_DATA_PATH=data/raw/data.csv
PROCESSED_DATA_DIR=data/processed
MODELS_DIR=models
ARTIFACTS_DIR=artifacts
ACTIVE_MODEL=cnn_lstm

# --- Backend ---
DATABASE_URL=sqlite:///./backend/etd.db
CORS_ORIGINS=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000

# --- Simulated real-time monitoring ---
SIMULATOR_API_URL=http://127.0.0.1:8000
SIMULATOR_INTERVAL_SECONDS=2

# --- Frontend (Vite reads variables prefixed with VITE_ from frontend/.env) ---
# VITE_API_BASE_URL=http://127.0.0.1:8000
